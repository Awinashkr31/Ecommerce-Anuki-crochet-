generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String                  @id @default(uuid())
  email              String                  @unique
  password           String?
  fullName           String                  @map("name")
  role               Role                    @default(CUSTOMER)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  phone              String?
  authProvider       String?                 @default("EMAIL") @map("auth_provider")
  avatarUrl          String?                 @map("avatar_url")
  pointsBalance      Int                     @default(0)
  abandonedCart      AbandonedCart?
  addresses          Address[]
  auditLogs          AuditLog[]
  couponUsages       CouponUsage[]
  inventoryLogs      InventoryLog[]
  notifications      Notification[]
  notificationPref   NotificationPreference?
  orders             Order[]
  orderTimelines     OrderTimeline[]
  posts              Post[]
  pushSubscriptions  PushSubscription[]
  reviews            Review[]
  rewardTransactions RewardTransaction[]
  wallet             Wallet?
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  street    String
  city      String
  state     String
  zipCode   String
  country   String   @default("India")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fullName  String
  isDefault Boolean  @default(false)
  landmark  String?
  phone     String
  user      User     @relation(fields: [userId], references: [id])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balance      Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  bannerUrl   String?
  isActive    Boolean    @default(true)
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children    Category[] @relation("Subcategories")
  products    Product[]

  @@index([isActive, parentId])
}

model Product {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  shortDesc            String?
  fullDesc             String?
  categoryId           String
  isMadeToOrder        Boolean               @default(false)
  processingDays       Int                   @default(2)
  basePrice            Float
  salePrice            Float?
  featured             Boolean               @default(false)
  trending             Boolean               @default(false)
  bestseller           Boolean               @default(false)
  limitedEdition       Boolean               @default(false)
  weight               Float?
  length               Float?
  width                Float?
  height               Float?
  lowStockThreshold    Int                   @default(5)
  maxOrdersPerDay      Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  barcode              String?
  brand                String?
  canonicalUrl         String?
  careInstructions     String?
  collections          String?
  costPrice            Float?
  countryOfOrigin      String                @default("India")
  freeShipping         Boolean               @default(false)
  isHandmade           Boolean               @default(true)
  material             String?
  ogImage              String?
  seoDesc              String?
  seoKeywords          String?
  seoTitle             String?
  shippingCharges      Float?
  sku                  String?
  status               String                @default("DRAFT")
  stockStatus          String                @default("IN_STOCK")
  subcategoryId        String?
  tags                 String?
  taxSettings          String?
  videoUrl             String?
  hasSizes             Boolean               @default(false)
  hasStyles            Boolean               @default(false)
  stock                Int                   @default(0)
  color                String?
  size                 String?
  wholesalePrice       Float?
  customizationOptions CustomizationOption[]
  images               Image[]
  category             Category              @relation(fields: [categoryId], references: [id])
  reviews              Review[]
  variants             Variant[]

  @@index([status, bestseller, createdAt(sort: Desc)])
  @@index([categoryId])
}

model Image {
  id        String   @id @default(uuid())
  url       String
  altText   String?
  order     Int      @default(0)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
}

model CustomizationOption {
  id        String   @id @default(uuid())
  name      String
  type      String
  options   String?
  required  Boolean  @default(false)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
}

model Variant {
  id                String         @id @default(uuid())
  productId         String
  sku               String         @unique
  color             String?
  size              String?
  price             Float
  stock             Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  attributes        Json?
  material          String?
  style             String?
  careInstructions  String?
  costPrice         Float?
  countryOfOrigin   String?
  freeShipping      Boolean?
  fullDesc          String?
  height            Float?
  isHandmade        Boolean?
  length            Float?
  lowStockThreshold Int?
  name              String?
  salePrice         Float?
  shippingCharges   Float?
  shortDesc         String?
  stockStatus       String?
  taxSettings       String?
  weight            Float?
  width             Float?
  imageUrls         String[]       @default([])
  wholesalePrice    Float?
  inventoryLogs     InventoryLog[]
  orderItems        OrderItem[]
  product           Product        @relation(fields: [productId], references: [id])
}

model Order {
  id            String          @id @default(uuid())
  userId        String?
  status        OrderStatus     @default(PENDING)
  totalAmount   Float
  internalNotes String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  couponUsages  CouponUsage[]
  user          User?           @relation(fields: [userId], references: [id])
  items         OrderItem[]
  timeline      OrderTimeline[]
  payment       Payment?
  shipment      Shipment?

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([status])
}

model Shipment {
  id          String   @id @default(uuid())
  orderId     String   @unique
  awbNumber   String   @unique
  courierName String
  trackingUrl String?
  status      String   @default("LABEL_CREATED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id])
}

model OrderItem {
  id            String         @id @default(uuid())
  orderId       String
  variantId     String
  quantity      Int
  price         Float
  customization String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  order         Order          @relation(fields: [orderId], references: [id])
  variant       Variant        @relation(fields: [variantId], references: [id])
  returnRequest ReturnRequest?

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id                  String         @id @default(uuid())
  orderId             String         @unique
  gateway             String
  transactionId       String         @unique
  amount              Float
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  currency            String         @default("INR")
  expiresAt           DateTime?
  failureReason       String?
  gatewayStatus       String?
  ipAddress           String?
  maxRetries          Int            @default(3)
  metadata            Json?
  paymentIntentId     String?
  paymentMethod       String?
  refundAmount        Float?         @default(0)
  refundTransactionId String?
  retryCount          Int            @default(0)
  sessionId           String?
  signatureVerified   Boolean        @default(false)
  userAgent           String?
  webhookReceived     Boolean        @default(false)
  status              PaymentStatus  @default(INITIATED)
  order               Order          @relation(fields: [orderId], references: [id])
  events              PaymentEvent[]
  logs                PaymentLog[]
}

model PaymentLog {
  id              String   @id @default(uuid())
  paymentId       String
  event           String
  status          String
  requestPayload  Json?
  responsePayload Json?
  webhookPayload  Json?
  ipAddress       String?
  device          String?
  browser         String?
  os              String?
  sessionId       String?
  createdAt       DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model PaymentEvent {
  id          String   @id @default(uuid())
  paymentId   String
  eventName   String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  imageUrls String[] @default([])
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([productId, approved])
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  amount      Float
  type        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  wallet      Wallet   @relation(fields: [walletId], references: [id])
}

model ReturnRequest {
  id            String    @id @default(uuid())
  orderItemId   String    @unique
  reason        String
  images        String[]
  status        String    @default("PENDING")
  refundMethod  String    @default("WALLET")
  restocked     Boolean   @default(false)
  adminComments String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id])
}

model Coupon {
  id                    String        @id @default(uuid())
  code                  String        @unique
  type                  String
  value                 Float
  minOrderValue         Float         @default(0)
  usageLimit            Int?
  usedCount             Int           @default(0)
  validFrom             DateTime      @default(now())
  validTo               DateTime?
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  applicableCategoryIds String[]      @default([])
  applicableProductIds  String[]      @default([])
  autoApply             Boolean       @default(false)
  buyQuantity           Int?
  description           String?
  excludeCategoryIds    String[]      @default([])
  excludeProductIds     String[]      @default([])
  firstOrderOnly        Boolean       @default(false)
  getQuantity           Int?
  internalNotes         String?
  maxDiscount           Float?
  maxUsesPerUser        Int?
  minQuantity           Int?
  name                  String?
  priority              Int           @default(0)
  stackable             Boolean       @default(false)
  status                String        @default("ACTIVE")
  showInCart            Boolean       @default(false)
  usages                CouponUsage[]
}

model CouponUsage {
  id             String   @id @default(uuid())
  userId         String?
  orderId        String
  couponId       String
  discountAmount Float
  orderTotal     Float
  ipAddress      String?
  deviceId       String?
  createdAt      DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id])
}

model Post {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  excerpt   String?
  imageUrl  String?
  keywords  String?
  seoDesc   String?
  seoTitle  String?
  author    User     @relation(fields: [authorId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model OrderTimeline {
  id         String   @id @default(uuid())
  orderId    String
  status     String
  userId     String?
  note       String?
  createdAt  DateTime @default(now())
  isInternal Boolean  @default(false)
  type       String   @default("STATUS_CHANGE")
  order      Order    @relation(fields: [orderId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
}

model InventoryLog {
  id           String   @id @default(uuid())
  variantId    String
  changeAmount Int
  reason       String
  userId       String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])
  variant      Variant  @relation(fields: [variantId], references: [id])
}

model StoreSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Notification {
  id         String            @id @default(uuid())
  userId     String
  role       String            @default("customer")
  title      String
  message    String
  category   String
  priority   String            @default("low")
  channel    String
  actionUrl  String?           @map("action_url")
  image      String?
  icon       String?
  status     String            @default("sent")
  isRead     Boolean           @default(false) @map("is_read")
  isArchived Boolean           @default(false) @map("is_archived")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs       NotificationLog[]
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  emailEnabled     Boolean  @default(true) @map("email_enabled")
  smsEnabled       Boolean  @default(false) @map("sms_enabled")
  whatsappEnabled  Boolean  @default(false) @map("whatsapp_enabled")
  pushEnabled      Boolean  @default(true) @map("push_enabled")
  marketingEnabled Boolean  @default(true) @map("marketing_enabled")
  orderEnabled     Boolean  @default(true) @map("order_enabled")
  securityEnabled  Boolean  @default(true) @map("security_enabled")
  reviewEnabled    Boolean  @default(true) @map("review_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id              String       @id @default(uuid())
  notificationId  String       @map("notification_id")
  deliveryChannel String       @map("delivery_channel")
  status          String
  deliveredAt     DateTime?    @map("delivered_at")
  openedAt        DateTime?    @map("opened_at")
  clickedAt       DateTime?    @map("clicked_at")
  failureReason   String?      @map("failure_reason")
  createdAt       DateTime     @default(now()) @map("created_at")
  notification    Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
}

model RewardTransaction {
  id          String   @id @default(uuid())
  userId      String
  points      Int
  type        String
  description String?
  orderId     String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AbandonedCart {
  id        String   @id @default(uuid())
  userId    String   @unique
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Banner {
  id        String    @id @default(uuid())
  title     String
  imageUrl  String
  link      String?
  status    String    @default("DRAFT")
  startDate DateTime?
  endDate   DateTime?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CATALOG_MANAGER
  ORDER_FULFILLMENT
  CUSTOMER_SUPPORT
  MARKETING
  FINANCE
  CUSTOMER
  B2B_CUSTOMER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  AWAITING_PAYMENT
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  PENDING
  SUCCESS
  FAILED
  USER_DROPPED
  CANCELLED
  TIMEOUT
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGEBACK
  COD_PENDING
  COD_CONFIRMED
  PAYMENT_REVIEW
  RETRY_PAYMENT
}
