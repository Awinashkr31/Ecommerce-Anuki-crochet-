// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CATALOG_MANAGER
  ORDER_FULFILLMENT
  CUSTOMER_SUPPORT
  MARKETING
  FINANCE
  CUSTOMER
  B2B_CUSTOMER
}

enum OrderStatus {
  AWAITING_PAYMENT
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  PENDING
  SUCCESS
  FAILED
  USER_DROPPED
  CANCELLED
  TIMEOUT
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGEBACK
  COD_PENDING
  COD_CONFIRMED
  PAYMENT_REVIEW
  RETRY_PAYMENT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String?
  fullName     String   @map("name")
  avatarUrl    String?  @map("avatar_url")
  authProvider String?  @default("EMAIL") @map("auth_provider")
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses      Address[]
  orders         Order[]
  reviews        Review[]
  wallet         Wallet?
  posts          Post[]
  auditLogs      AuditLog[]
  orderTimelines OrderTimeline[]
  inventoryLogs  InventoryLog[]
  couponUsages   CouponUsage[]
  notifications  Notification[]
  notificationPref NotificationPreference?
  pointsBalance    Int      @default(0)
  rewardTransactions RewardTransaction[]
  abandonedCart    AbandonedCart?
  pushSubscriptions PushSubscription[]
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fullName  String
  phone     String
  street    String
  city      String
  state     String
  zipCode   String
  country   String   @default("India")
  landmark  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id])
  balance      Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  bannerUrl   String?
  isActive    Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children    Category[] @relation("Subcategories")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive, parentId])
}

model Product {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  shortDesc      String?
  fullDesc       String?
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  isMadeToOrder  Boolean  @default(false)
  processingDays Int      @default(2)
  basePrice      Float
  salePrice      Float?
  wholesalePrice Float?
  
  // New pricing & inventory fields
  costPrice         Float?
  taxSettings       String?
  sku               String?
  barcode           String?
  stockStatus       String  @default("IN_STOCK")
  stock             Int     @default(0)

  // Variant Config
  hasStyles         Boolean @default(false)
  hasSizes          Boolean @default(false)

  // Organization fields
  subcategoryId     String?
  brand             String?
  tags              String?
  collections       String?

  // Attributes
  isHandmade        Boolean @default(true)
  material          String?
  careInstructions  String?
  countryOfOrigin   String  @default("India")
  color             String?
  size              String?

  // Shipping
  shippingCharges   Float?
  freeShipping      Boolean @default(false)

  // SEO
  seoTitle          String?
  seoDesc           String?
  seoKeywords       String?
  canonicalUrl      String?
  ogImage           String?

  // Media
  videoUrl          String?

  // Status
  status            String  @default("DRAFT")

  featured          Boolean @default(false)
  trending          Boolean @default(false)
  bestseller        Boolean @default(false)
  limitedEdition    Boolean @default(false)
  weight            Float?
  length            Float?
  width             Float?
  height            Float?
  lowStockThreshold Int     @default(5)
  maxOrdersPerDay   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants             Variant[]
  reviews              Review[]
  images               Image[]
  customizationOptions CustomizationOption[]

  @@index([status, bestseller, createdAt(sort: Desc)])
  @@index([categoryId])
}

model Image {
  id        String   @id @default(uuid())
  url       String
  altText   String?
  order     Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomizationOption {
  id        String   @id @default(uuid())
  name      String // e.g., "Color Theme", "Embroidery Text"
  type      String // e.g., "TEXT", "DROPDOWN"
  options   String? // comma separated or JSON for dropdown choices
  required  Boolean  @default(false)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Variant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  sku       String   @unique
  color     String?
  size      String?
  material  String?
  style     String?
  attributes Json?
  imageUrls String[] @default([])
  price     Float
  stock     Int      @default(0)

  // Overrides for Variant vs Product
  name              String?
  shortDesc         String?
  fullDesc          String?
  salePrice         Float?
  wholesalePrice    Float?
  costPrice         Float?
  weight            Float?
  length            Float?
  width             Float?
  height            Float?
  isHandmade        Boolean?
  careInstructions  String?
  countryOfOrigin   String?
  taxSettings       String?
  stockStatus       String?
  lowStockThreshold Int?
  shippingCharges   Float?
  freeShipping      Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]
}

model Order {
  id            String      @id @default(uuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING)
  totalAmount   Float
  internalNotes String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items    OrderItem[]
  payment  Payment?
  shipment Shipment?
  timeline OrderTimeline[]
  couponUsages CouponUsage[]

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([status])
}

model Shipment {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  awbNumber   String   @unique
  courierName String
  trackingUrl String?
  status      String   @default("LABEL_CREATED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderItem {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  variantId     String
  variant       Variant        @relation(fields: [variantId], references: [id])
  quantity      Int
  price         Float
  customization String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  returnRequest ReturnRequest?

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id                  String        @id @default(uuid())
  orderId             String        @unique
  order               Order         @relation(fields: [orderId], references: [id])
  paymentIntentId     String?       // Cashfree order_id / Razorpay order_id
  transactionId       String        @unique
  gateway             String        // CASHFREE, RAZORPAY, COD
  amount              Float
  currency            String        @default("INR")
  paymentMethod       String?       // upi, card, netbanking, wallet, cod
  status              PaymentStatus @default(INITIATED)
  gatewayStatus       String?       // raw status string from gateway
  retryCount          Int           @default(0)
  maxRetries          Int           @default(3)
  webhookReceived     Boolean       @default(false)
  signatureVerified   Boolean       @default(false)
  refundAmount        Float?        @default(0)
  refundTransactionId String?
  metadata            Json?         // extra data (fraud score, etc.)
  ipAddress           String?
  userAgent           String?
  sessionId           String?
  expiresAt           DateTime?     // payment session expiry
  failureReason       String?       // human-readable failure reason
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  logs   PaymentLog[]
  events PaymentEvent[]
}

model PaymentLog {
  id              String   @id @default(uuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  event           String   // CREATE_ORDER, VERIFY, WEBHOOK, RETRY, REFUND
  status          String   // request status
  requestPayload  Json?
  responsePayload Json?
  webhookPayload  Json?
  ipAddress       String?
  device          String?
  browser         String?
  os              String?
  sessionId       String?
  createdAt       DateTime @default(now())

  @@index([paymentId])
}

model PaymentEvent {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventName   String   // CHECKOUT_STARTED, GATEWAY_OPENED, PAYMENT_PROCESSING, etc.
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([paymentId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  comment   String?
  imageUrls String[] @default([])
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, approved])
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  amount      Float
  type        String // "CREDIT", "DEBIT"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReturnRequest {
  id            String    @id @default(uuid())
  orderItemId   String    @unique
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id])
  reason        String
  images        String[] // URLs of images provided by customer
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, REFUNDED
  refundMethod  String    @default("WALLET") // WALLET, ORIGINAL
  restocked     Boolean   @default(false)
  adminComments String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String?
  description   String?
  internalNotes String?
  type          String // "PERCENTAGE", "FLAT", "FREE_SHIPPING", "BOGO"
  value         Float
  maxDiscount   Float?
  minOrderValue Float     @default(0)
  minQuantity   Int?
  
  // Usage limits
  usageLimit       Int?
  usedCount        Int       @default(0)
  maxUsesPerUser   Int?
  firstOrderOnly   Boolean   @default(false)
  
  // Date window
  validFrom     DateTime  @default(now())
  validTo       DateTime?
  
  // BOGO / Target logic
  buyQuantity   Int?
  getQuantity   Int?
  
  // Arrays for restrictions (storing IDs)
  applicableProductIds  String[] @default([])
  applicableCategoryIds String[] @default([])
  excludeProductIds     String[] @default([])
  excludeCategoryIds    String[] @default([])
  
  // Behaviors
  autoApply     Boolean   @default(false)
  stackable     Boolean   @default(false)
  showInCart    Boolean   @default(false)
  priority      Int       @default(0)
  
  // Status (DRAFT, SCHEDULED, ACTIVE, PAUSED, EXPIRED, DISABLED)
  status        String    @default("ACTIVE")
  isActive      Boolean   @default(true) // Kept for backward compatibility
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  usages        CouponUsage[]
}

model CouponUsage {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  discountAmount  Float
  orderTotal      Float
  ipAddress       String?
  deviceId        String?
  createdAt       DateTime @default(now())
}

model Post {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String // Markdown
  published Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entityId  String?
  details   String? // JSON stringified
  createdAt DateTime @default(now())
}

model OrderTimeline {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  status     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  note       String?
  isInternal Boolean  @default(false)
  type       String   @default("STATUS_CHANGE") // STATUS_CHANGE, NOTE, COMMUNICATION
  createdAt  DateTime @default(now())
}

model InventoryLog {
  id           String   @id @default(uuid())
  variantId    String
  variant      Variant  @relation(fields: [variantId], references: [id])
  changeAmount Int
  reason       String // ORDER, RESTOCK, MANUAL
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
}

model StoreSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("customer") // admin, customer, staff
  title       String
  message     String
  category    String   // orders, payments, customers, inventory, etc.
  priority    String   @default("low") // low, medium, high, critical
  channel     String   // in-app, email, sms, push, all
  actionUrl   String?  @map("action_url")
  image       String?
  icon        String?
  status      String   @default("sent") // pending, sent, failed
  isRead      Boolean  @default(false) @map("is_read")
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  logs        NotificationLog[]
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled     Boolean  @default(true) @map("email_enabled")
  smsEnabled       Boolean  @default(false) @map("sms_enabled")
  whatsappEnabled  Boolean  @default(false) @map("whatsapp_enabled")
  pushEnabled      Boolean  @default(true) @map("push_enabled")
  
  marketingEnabled Boolean  @default(true) @map("marketing_enabled")
  orderEnabled     Boolean  @default(true) @map("order_enabled")
  securityEnabled  Boolean  @default(true) @map("security_enabled")
  reviewEnabled    Boolean  @default(true) @map("review_enabled")
  
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
}

model NotificationLog {
  id               String   @id @default(uuid())
  notificationId   String   @map("notification_id")
  notification     Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deliveryChannel  String   @map("delivery_channel") // IN_APP, EMAIL, SMS, PUSH
  status           String   // DELIVERED, FAILED
  deliveredAt      DateTime? @map("delivered_at")
  openedAt         DateTime? @map("opened_at")
  clickedAt        DateTime? @map("clicked_at")
  failureReason    String?   @map("failure_reason")
  createdAt        DateTime @default(now()) @map("created_at")
}

model RewardTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int
  type        String   // EARNED, REDEEMED
  description String?
  orderId     String?  // Optional relation if tied to an order
  createdAt   DateTime @default(now())
}

model AbandonedCart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Json     // Store the cart items as JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Banner {
  id        String    @id @default(uuid())
  title     String
  imageUrl  String
  link      String?
  status    String    @default("DRAFT") // DRAFT, LIVE, SCHEDULED
  startDate DateTime?
  endDate   DateTime?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
